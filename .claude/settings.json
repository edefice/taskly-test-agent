{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git * commit *)",
      "Bash(git * commit)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git * push)",
      "Bash(git merge *)",
      "Bash(git * merge *)",
      "Bash(git * merge)",
      "Bash(git rebase *)",
      "Bash(git * rebase *)",
      "Bash(git * rebase)",
      "Bash(git reset *)",
      "Bash(git * reset *)",
      "Bash(git * reset)",
      "Bash(git stash *)",
      "Bash(git * stash *)",
      "Bash(git * stash)",
      "Bash(git tag *)",
      "Bash(git * tag *)",
      "Bash(git * tag)",
      "Bash(git checkout -- *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-tools.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
